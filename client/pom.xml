<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.glitchwrks.paste98</groupId>
    <artifactId>gw_paste98-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>gw_paste98-client</artifactId>
  <name>gw_paste98 client</name>
  <description>Swing tray application for Windows 98 / Java 5</description>

  <properties>
    <!-- NSIS compiler for the installer; override with -Dmakensis=/path/to/makensis -->
    <makensis>makensis</makensis>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.glitchwrks.paste98</groupId>
      <artifactId>gw_paste98-core</artifactId>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>gw_paste98</finalName>

    <resources>
      <!-- Window icon, generated by native/make_icon.py alongside GWTRAY.ICO. -->
      <resource>
        <directory>${project.basedir}/../native/prebuilt</directory>
        <includes>
          <include>gwtray.png</include>
        </includes>
        <targetPath>com/glitchwrks/paste98/client</targetPath>
      </resource>
    </resources>

    <plugins>
      <!--
        Tests use the file-backed java.util.prefs backend with a scratch file,
        so they never touch a developer's real settings (or the registry).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <java.util.prefs.PreferencesFactory>com.glitchwrks.paste98.client.prefs.FilePreferencesFactory</java.util.prefs.PreferencesFactory>
            <paste98.prefs.user>${project.build.directory}/test-prefs/PASTE98.PRF</paste98.prefs.user>
            <paste98.prefs.system>${project.build.directory}/test-prefs/PASTE98S.PRF</paste98.prefs.system>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-libs</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- GWPASTE.JAR: the client, core and the Bouncy Castle classes they use, shrunk by ProGuard. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>shrink</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <java classname="proguard.ProGuard" fork="true" failonerror="true"
                      classpathref="maven.plugin.classpath">
                  <sysproperty key="target.dir" value="${project.build.directory}"/>
                  <sysproperty key="manifest.dir" value="${project.basedir}/src/proguard/manifest"/>
                  <sysproperty key="lib.dir" value="${project.build.directory}/lib"/>
                  <sysproperty key="bc.version" value="${bc.version}"/>
                  <sysproperty key="core.version" value="${project.version}"/>
                  <sysproperty key="jdk8.home" value="${java.home}/.."/>
                  <arg value="@${project.basedir}/src/proguard/shrink.pro"/>
                </java>
              </target>
            </configuration>
          </execution>

          <!--
            target/gw_paste98-VERSION-setup.exe, an NSIS installer (src/installer).
            Needs makensis (NSIS 3) on the PATH, or -Dmakensis=/path/to/makensis;
            without it the build warns and makes only the zip. The jar goes in
            uncompressed so the installer's solid LZMA compresses it as a whole,
            which halves the download.
          -->
          <execution>
            <id>installer</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                <condition property="nsis.found">
                  <or>
                    <available file="${makensis}"/>
                    <available file="${makensis}" filepath="${env.PATH}"/>
                  </or>
                </condition>
                <echo level="warning" unless:set="nsis.found"
                      message="makensis (NSIS 3) not found: skipping the installer. Install NSIS or pass -Dmakensis=/path/to/makensis."/>

                <sequential if:set="nsis.found">
                  <!-- The version shown by the installer comes from Version.java. -->
                  <loadfile property="app.version" srcfile="${project.basedir}/src/main/java/com/glitchwrks/paste98/client/Version.java">
                    <filterchain>
                      <linecontainsregexp>
                        <regexp pattern="String VERSION = &quot;"/>
                      </linecontainsregexp>
                      <replaceregex pattern=".*VERSION = &quot;([0-9.]+)&quot;.*" replace="\1"/>
                      <striplinebreaks/>
                    </filterchain>
                  </loadfile>

                  <property name="stage" value="${project.build.directory}/installer/stage"/>
                  <delete dir="${project.build.directory}/installer"/>
                  <mkdir dir="${project.build.directory}/installer/jar"/>
                  <unzip src="${project.build.directory}/GWPASTE.JAR" dest="${project.build.directory}/installer/jar"/>
                  <jar destfile="${stage}/GWPASTE.JAR" compress="false" zip64Mode="never"
                       manifest="${project.build.directory}/installer/jar/META-INF/MANIFEST.MF">
                    <fileset dir="${project.build.directory}/installer/jar" excludes="META-INF/MANIFEST.MF"/>
                  </jar>
                  <copy file="${project.basedir}/../native/prebuilt/gwtray.dll" tofile="${stage}/GWTRAY.DLL"/>
                  <copy file="${project.basedir}/../native/prebuilt/gwtray.ico" tofile="${stage}/GWTRAY.ICO"/>
                  <copy file="${project.basedir}/README.md" tofile="${stage}/README.TXT"/>
                  <copy file="${project.basedir}/../LICENSE" tofile="${stage}/LICENSE.TXT"/>
                  <fixcrlf srcdir="${stage}" includes="*.TXT" eol="crlf"/>

                  <exec executable="${makensis}" failonerror="true">
                    <arg value="-V2"/>
                    <arg value="-WX"/> <!-- warnings are errors -->
                    <arg value="-DVERSION=${app.version}"/>
                    <arg value="-DSTAGE=${stage}"/>
                    <arg value="-DOUTFILE=${project.build.directory}/gw_paste98-${app.version}-setup.exe"/>
                    <arg value="${project.basedir}/src/installer/gw_paste98.nsi"/>
                  </exec>
                </sequential>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- target/gw_paste98-win98.zip -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <descriptors>
            <descriptor>src/assembly/win98.xml</descriptor>
          </descriptors>
        </configuration>
        <executions>
          <execution>
            <id>win98-zip</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
