<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.glitchwrks.paste98</groupId>
    <artifactId>gw_paste98-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>gw_paste98-client</artifactId>
  <name>gw_paste98 client</name>
  <description>Swing tray application for Windows 95/98 / Java 1.3 or later</description>

  <properties>
    <!-- NSIS compiler for the installer; override with -Dmakensis=/path/to/makensis -->
    <makensis>makensis</makensis>
    <!-- HTML Help compiler (Free Pascal); override with -Dchmcmd=/path/to/chmcmd -->
    <chmcmd>chmcmd</chmcmd>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.glitchwrks.paste98</groupId>
      <artifactId>gw_paste98-core</artifactId>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>gw_paste98</finalName>

    <resources>
      <!--
        Window icon (native/make_icon.py, alongside GWTRAY.ICO) and the About
        window's picture (native/make_logo.py).
      -->
      <resource>
        <directory>${project.basedir}/../native/prebuilt</directory>
        <includes>
          <include>gwtray.png</include>
          <include>gwtray16.png</include>
          <include>gwabout.png</include>
        </includes>
        <targetPath>com/glitchwrks/paste98/client</targetPath>
      </resource>
    </resources>

    <plugins>
      <!--
        Tests use a scratch settings file, so they never touch a developer's
        real settings. PrefsXmlTest checks compatibility against the JDK's own
        java.util.prefs, pointed at a scratch directory too.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <paste98.prefs.user>${project.build.directory}/test-prefs/PASTE98.PRF</paste98.prefs.user>
            <java.util.prefs.userRoot>${project.build.directory}/test-prefs/jdk</java.util.prefs.userRoot>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-libs</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
          <execution>
            <id>copy-java13-signature</id>
            <phase>package</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.codehaus.mojo.signature</groupId>
                  <artifactId>java13</artifactId>
                  <version>1.0</version>
                  <classifier>java13</classifier>
                  <type>signature</type>
                  <destFileName>java13.signature</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/sig</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        GWPASTE.JAR: the client, core and the Bouncy Castle classes they use.
        Bouncy Castle's jdk14 jars are retargeted to Java 1.3 (retro13's
        Retarget13), everything is shrunk by ProGuard, then the jar is checked
        against the Java 1.3 API (Check13). The build fails if anything in it
        needs a newer Java.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
            <version>${asm.version}</version>
          </dependency>
          <dependency>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>animal-sniffer</artifactId>
            <version>${animal-sniffer.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>shrink</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <property name="t" value="${project.build.directory}"/>
                <!-- retro13 is built earlier in the reactor; its dependencies are this plugin's. -->
                <path id="tools.cp">
                  <pathelement location="${project.basedir}/../retro13/target/classes"/>
                  <path refid="maven.plugin.classpath"/>
                </path>

                <delete dir="${t}/bc13"/>
                <mkdir dir="${t}/bc13"/>
                <java classname="Retarget13" classpathref="tools.cp" fork="true" failonerror="true">
                  <arg value="${t}/lib/bcprov-jdk14-${bc.version}.jar"/>
                  <arg value="${t}/bc13/bcprov13.jar"/>
                </java>
                <java classname="Retarget13" classpathref="tools.cp" fork="true" failonerror="true">
                  <arg value="${t}/lib/bctls-jdk14-${bc.version}.jar"/>
                  <arg value="${t}/bc13/bctls13.jar"/>
                </java>
                <java classname="Retarget13" classpathref="tools.cp" fork="true" failonerror="true">
                  <arg value="${t}/lib/bcutil-jdk14-${bc.version}.jar"/>
                  <arg value="${t}/bc13/bcutil13.jar"/>
                </java>

                <delete file="${t}/GWPASTE.JAR"/>
                <java classname="proguard.ProGuard" fork="true" failonerror="true"
                      classpathref="maven.plugin.classpath">
                  <sysproperty key="target.dir" value="${project.build.directory}"/>
                  <sysproperty key="manifest.dir" value="${project.basedir}/src/proguard/manifest"/>
                  <sysproperty key="lib.dir" value="${project.build.directory}/lib"/>
                  <sysproperty key="bc.version" value="${bc.version}"/>
                  <sysproperty key="core.version" value="${project.version}"/>
                  <sysproperty key="jdk8.home" value="${java.home}/.."/>
                  <arg value="@${project.basedir}/src/proguard/shrink.pro"/>
                </java>

                <delete dir="${t}/gwpaste-unpacked"/>
                <unzip src="${t}/GWPASTE.JAR" dest="${t}/gwpaste-unpacked"/>
                <java classname="Check13" classpathref="tools.cp" fork="true" failonerror="true">
                  <arg value="${t}/GWPASTE.JAR"/>
                  <arg value="${t}/sig/java13.signature"/>
                  <arg value="${t}/gwpaste-unpacked"/>
                </java>
                <!-- Second opinion from the JDK's @since tags: the java13 signature lists
                     non-public members, so a constructor made public in 1.4 got through. -->
                <java classname="Since13" classpathref="tools.cp" fork="true" failonerror="true" maxmemory="2g">
                  <classpath>
                    <pathelement location="${java.home}/../lib/tools.jar"/>
                  </classpath>
                  <arg value="${t}/GWPASTE.JAR"/>
                  <arg value="${java.home}/../src.zip"/>
                  <arg value="${java.home}/lib/rt.jar"/>
                </java>
              </target>
            </configuration>
          </execution>

          <!--
            target/GWPASTE.CHM, the help (src/help), compiled by chmcmd from
            Free Pascal (apt install fp-utils), or -Dchmcmd=/path/to/chmcmd.

            target/gw_paste98-VERSION-setup.exe, an NSIS installer (src/installer).
            Needs makensis (NSIS 3) on the PATH, or -Dmakensis=/path/to/makensis,
            and the help. Without either tool the build warns and leaves that
            part out. The jar goes in uncompressed so the installer's solid LZMA
            compresses it as a whole, which halves the download.
          -->
          <execution>
            <id>help-and-installer</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                <!-- The version shown in the help and installer comes from Version.java. -->
                <loadfile property="app.version" srcfile="${project.basedir}/src/main/java/com/glitchwrks/paste98/client/Version.java">
                  <filterchain>
                    <linecontainsregexp>
                      <regexp pattern="String VERSION = &quot;"/>
                    </linecontainsregexp>
                    <replaceregex pattern=".*VERSION = &quot;([0-9.]+)&quot;.*" replace="\1"/>
                    <striplinebreaks/>
                  </filterchain>
                </loadfile>

                <condition property="chmcmd.found">
                  <or>
                    <available file="${chmcmd}"/>
                    <available file="${chmcmd}" filepath="${env.PATH}"/>
                  </or>
                </condition>
                <condition property="nsis.found">
                  <and>
                    <isset property="chmcmd.found"/>
                    <or>
                      <available file="${makensis}"/>
                      <available file="${makensis}" filepath="${env.PATH}"/>
                    </or>
                  </and>
                </condition>
                <echo level="warning" unless:set="chmcmd.found"
                      message="chmcmd (Free Pascal) not found: skipping the help file and installer. Install fp-utils or pass -Dchmcmd=/path/to/chmcmd."/>
                <echo level="warning" unless:set="nsis.found" if:set="chmcmd.found"
                      message="makensis (NSIS 3) not found: skipping the installer. Install NSIS or pass -Dmakensis=/path/to/makensis."/>

                <sequential if:set="chmcmd.found">
                  <delete dir="${project.build.directory}/help"/>
                  <copy todir="${project.build.directory}/help">
                    <fileset dir="${project.basedir}/src/help"/>
                    <filterset begintoken="@" endtoken="@">
                      <filter token="VERSION" value="${app.version}"/>
                    </filterset>
                  </copy>
                  <exec executable="${chmcmd}" dir="${project.build.directory}/help" failonerror="true">
                    <arg value="gwpaste.hhp"/>
                  </exec>
                  <copy file="${project.build.directory}/help/GWPASTE.CHM" tofile="${project.build.directory}/GWPASTE.CHM"/>
                </sequential>

                <sequential if:set="nsis.found">
                  <property name="stage" value="${project.build.directory}/installer/stage"/>
                  <delete dir="${project.build.directory}/installer"/>
                  <mkdir dir="${project.build.directory}/installer/jar"/>
                  <unzip src="${project.build.directory}/GWPASTE.JAR" dest="${project.build.directory}/installer/jar"/>
                  <jar destfile="${stage}/GWPASTE.JAR" compress="false" zip64Mode="never"
                       manifest="${project.build.directory}/installer/jar/META-INF/MANIFEST.MF">
                    <fileset dir="${project.build.directory}/installer/jar" excludes="META-INF/MANIFEST.MF"/>
                  </jar>
                  <copy file="${project.basedir}/../native/prebuilt/gwtray.dll" tofile="${stage}/GWTRAY.DLL"/>
                  <copy file="${project.basedir}/../native/prebuilt/gwtray.ico" tofile="${stage}/GWTRAY.ICO"/>
                  <copy file="${project.build.directory}/GWPASTE.CHM" tofile="${stage}/GWPASTE.CHM"/>
                  <copy file="${project.basedir}/../LICENSE" tofile="${stage}/LICENSE.TXT"/>
                  <fixcrlf srcdir="${stage}" includes="*.TXT" eol="crlf"/>

                  <exec executable="${makensis}" failonerror="true">
                    <arg value="-V2"/>
                    <arg value="-WX"/> <!-- warnings are errors -->
                    <arg value="-DVERSION=${app.version}"/>
                    <arg value="-DSTAGE=${stage}"/>
                    <arg value="-DOUTFILE=${project.build.directory}/gw_paste98-${app.version}-setup.exe"/>
                    <arg value="${project.basedir}/src/installer/gw_paste98.nsi"/>
                  </exec>
                </sequential>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- target/gw_paste98-win98.zip -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <descriptors>
            <descriptor>src/assembly/win98.xml</descriptor>
          </descriptors>
        </configuration>
        <executions>
          <execution>
            <id>win98-zip</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
